diff --git a/sim/arc/sim-if.c b/sim/arc/sim-if.c
index be4d99e..ff9457e 100644
--- a/sim/arc/sim-if.c
+++ b/sim/arc/sim-if.c
@@ -34,6 +34,78 @@
 #include <stdlib.h>
 #endif
 
+/* Laboratory provenance for the chosen 128 MiB CPU bank; not physical RAM geometry. */
+#define S33_RAM_LIMIT 0x08000000UL
+static unsigned char s33_defined[S33_RAM_LIMIT / 8];
+static int s33_defined_ready;
+static int s33_defined_active;
+
+static void
+s33_defined_init (SIM_CPU *cpu)
+{
+  const char *spec = getenv ("S33_DEFINED_RANGES");
+  unsigned long ranges = 0, bytes = 0;
+  if (s33_defined_ready) return;
+  if (!spec || !*spec) {
+    sim_io_eprintf (CPU_STATE (cpu), "S33_PROVENANCE_CONFIG missing_ranges=1\n");
+    cgen_rtx_error (cpu, "Explicit initial provenance required");
+    return;
+  }
+  if (strcmp (spec, "none") != 0) {
+    while (*spec) {
+      char *next;
+      unsigned long start = strtoul (spec, &next, 0), length, i;
+      if (next == spec || *next != ':') goto invalid;
+      spec = next + 1;
+      length = strtoul (spec, &next, 0);
+      if (next == spec || (*next && *next != ',') || !length
+          || start >= S33_RAM_LIMIT || length > S33_RAM_LIMIT - start) goto invalid;
+      for (i = start; i < start + length; ++i)
+        s33_defined[i >> 3] |= 1U << (i & 7);
+      ranges++; bytes += length;
+      if (!*next) break;
+      spec = next + 1;
+      if (!*spec) goto invalid;
+    }
+  }
+  s33_defined_ready = 1;
+  sim_io_eprintf (CPU_STATE (cpu), "S33_PROVENANCE bank_bytes=134217728 initial_ranges=%lu declared_bytes=%lu NOBITS_known_by_default=0\n", ranges, bytes);
+  return;
+invalid:
+  sim_io_eprintf (CPU_STATE (cpu), "S33_PROVENANCE_CONFIG invalid_ranges=1\n");
+  cgen_rtx_error (cpu, "Invalid initial provenance ranges");
+}
+
+void
+s33_require_defined (SIM_CPU *cpu, IADDR pc, ADDR address, unsigned size, int fetch)
+{
+  unsigned i;
+  if (!s33_defined_active) return;
+  s33_defined_init (cpu);
+  for (i = 0; i < size; ++i) {
+    unsigned long long byte = (unsigned long long) address + i;
+    if (byte < S33_RAM_LIMIT && !(s33_defined[byte >> 3] & (1U << (byte & 7)))) {
+      sim_io_eprintf (CPU_STATE (cpu), "S33_UNDEFINED pc=%08lx address=%08lx size=%u first=%08lx operation=%s\n",
+                      (unsigned long) pc, (unsigned long) address, size, (unsigned long) byte,
+                      fetch ? "decoder_fetch" : "data_read");
+      cgen_rtx_error (cpu, "Read without declared input or preceding guest store");
+      return;
+    }
+  }
+}
+
+void
+s33_store_defined (SIM_CPU *cpu, IADDR pc, ADDR address, unsigned size)
+{
+  unsigned i;
+  if (!s33_defined_active) return;
+  s33_defined_init (cpu);
+  for (i = 0; i < size; ++i) {
+    unsigned long long byte = (unsigned long long) address + i;
+    if (byte < S33_RAM_LIMIT) s33_defined[byte >> 3] |= 1U << (byte & 7);
+  }
+}
+
